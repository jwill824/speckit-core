{
  "name": "speckit-core",
  "description": "The spec-kit workflow layer — tool-agnostic templates, scripts, and memory stubs for spec-driven AI development. Distributed via git submodule so downstream repos stay in sync automatically.",
  "version": "1.0.0",
  "author": "jwill824",
  "repository": "https://github.com/jwill824/speckit-core",
  "category": "process",
  "effect": "Read+Write",
  "install": "bash <(curl -fsSL https://raw.githubusercontent.com/jwill824/speckit-core/main/install.sh)",
  "install_method": "submodule",
  "submodule_path": ".speckit",
  "symlinks": {
    ".specify/templates": "../.speckit/.specify/templates",
    ".specify/scripts":   "../.speckit/.specify/scripts"
  },
  "local_only": [
    ".specify/memory/constitution.md",
    ".specify/memory/stack.md"
  ],
  "components": {
    "templates": [
      "constitution", "stack", "spec", "plan", "tasks", "agent-file", "checklist"
    ],
    "scripts": [
      "bootstrap", "check-prerequisites", "common",
      "create-new-feature", "setup-plan", "update-agent-context"
    ]
  }
}
